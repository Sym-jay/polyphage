# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Notebooks
.ipynb_checkpoints/

# Upstream repos -- cloned by the notebook at runtime, never vendored here
ProteinMPNN/
ThermoMPNN/

# Model weights -- large, downloaded on demand
*.pt
*.pth
*.ckpt

# Colab run artifacts -- all regenerated by the notebook
inputs/
outputs/
*.pdb
*.fasta
*.npz

# ProteinMPNN's parsed-structure files are .jsonl and regenerable;
# the run log under results/ is the experimental record and is tracked.
*.jsonl
!results/*.jsonl

# OS
.DS_Store
